| tstats summariesonly=false count min(_time) AS firstTime max(_time) AS lastTime
    FROM datamodel=Endpoint.Processes
    WHERE Processes.process_name IN ("powershell.exe", "pwsh.exe")
    BY Processes.dest Processes.user Processes.process_name Processes.process Processes.parent_process_name
| rename Processes.* AS *
| eval command=lower(process)
| where (
    like(command, "%set-mppreference%") OR like(command, "%add-mppreference%")
  ) AND (
    like(command, "%disablerealtimemonitoring%")
    OR like(command, "%disablebehaviormonitoring%")
    OR like(command, "%disableioavprotection%")
    OR like(command, "%exclusionpath%")
    OR like(command, "%exclusionprocess%")
    OR like(command, "%exclusionextension%")
  )
| table firstTime lastTime dest user parent_process_name process_name process count
